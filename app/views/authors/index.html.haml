%section.container
  %h1.mb-3 Authors

  #authors.mb-3
    .row.fw-bold.border-bottom
      .col ID
      .col Name
      .col.gap-2
        Actions
    = render @authors

  = turbo_frame_tag "new_author_frame" do
    .d-flex.w-100.align-items-center.justify-content-end.gap-2
      = link_to "New author", [:new, :author], class: "btn btn-sm btn-primary", data: { turbo_stream: true }
