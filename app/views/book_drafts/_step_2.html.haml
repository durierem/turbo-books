= form_with model: book_draft do |f|
  = f.hidden_field :step, value: 2
  .mb-3
    = f.label :author_id, class: 'form-label'
    = f.collection_select :author_id, Author.all, :id, :name, {}, { class: 'form-select' }
  .mb-3.d-flex.justify-content-between
    = link_to "Previous",  [ :edit, @book_draft, step: 1 ], class: "btn btn-sm btn-secondary"
    = f.submit "Next", class: "btn btn-sm btn-primary"
