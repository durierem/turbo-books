%section.container
  %h1.mb-3 Lendings

  .mb-3
    .row.fw-bold.border-bottom
      .col ID
      .col Book
      .col Due
      .col Actions
  .mb-3
    = render @lendings

  .d-flex.w-100.align-items-center.justify-content-end.gap-2
    = link_to "New lending", [:new, :lending], class: "btn btn-sm btn-primary"
